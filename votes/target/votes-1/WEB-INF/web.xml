<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">
    <servlet>
        <servlet-name>VoterLoginServlet</servlet-name>
        <servlet-class>com.voting.servlets.VoterLoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>VoterRegisterServlet</servlet-name>
        <servlet-class>com.voting.servlets.VoterRegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CandidateServlet</servlet-name>
        <servlet-class>com.voting.servlets.CandidateServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CandidateManagementServlet</servlet-name>
        <servlet-class>com.voting.servlets.CandidateManagementServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetPositionsServlet</servlet-name>
        <servlet-class>com.voting.servlets.GetPositionsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ElectionServlet</servlet-name>
        <servlet-class>com.voting.servlets.ElectionServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetAllElectionsServlet</servlet-name>
        <servlet-class>com.voting.servlets.GetAllElectionsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SubmitVoteServlet</servlet-name>
        <servlet-class>com.voting.servlets.SubmitVoteServlet</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>VoterLoginServlet</servlet-name>
        <url-pattern>/VoterLoginServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>VoterRegisterServlet</servlet-name>
        <url-pattern>/VoterRegisterServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CandidateServlet</servlet-name>
        <url-pattern>/CandidateServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CandidateManagementServlet</servlet-name>
        <url-pattern>/CandidateManagementServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetPositionsServlet</servlet-name>
        <url-pattern>/GetPositionsServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ElectionServlet</servlet-name>
        <url-pattern>/ElectionServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetAllElectionsServlet</servlet-name>
        <url-pattern>/GetAllElectionsServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SubmitVoteServlet</servlet-name>
        <url-pattern>/SubmitVoteServlet</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
